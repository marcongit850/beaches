{
  // Walton County beach access site. Worker name is beaches.
  // Do not add a custom domain in this file. DNS stays unset on purpose.
  // Contact mail uses Worker secrets RESEND_API_KEY and CONTACT_EMAIL.
  // Optional CONTACT_FROM is the verified from address when Resend requires one.
  // Do not put those values in this file.
  "name": "beaches",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/contact", "/api/contact/"]
  },
  // Required by `npx wrangler preview`. Keep this empty. Do not put secrets here.
  "previews": {}
}
